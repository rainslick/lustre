--!strict
-- Tests for Lustre level registry, parsing and custom levels.
local test = require("@std/test")
local Lustre = require("../src/lustre")
local Levels = require("../src/levels")

test.suite("Levels", function(suite)
	suite:case("builtinsExist", function(asserts)
		asserts.eq(Levels.TRACE, "TRACE")
		asserts.eq(Levels.DEBUG, "DEBUG")
		asserts.eq(Levels.INFO, "INFO")
		asserts.eq(Levels.SUCCESS, "SUCCESS")
		asserts.eq(Levels.WARN, "WARN")
		asserts.eq(Levels.ERROR, "ERROR")
		asserts.eq(Levels.FATAL, "FATAL")
	end)

	suite:case("severityOrder", function(asserts)
		asserts.that(Levels.value("TRACE") < Levels.value("DEBUG"), "trace < debug")
		asserts.that(Levels.value("DEBUG") < Levels.value("INFO"), "debug < info")
		asserts.that(Levels.value("INFO") < Levels.value("SUCCESS"), "info < success")
		asserts.that(Levels.value("SUCCESS") < Levels.value("WARN"), "success < warn")
		asserts.that(Levels.value("WARN") < Levels.value("ERROR"), "warn < error")
		asserts.that(Levels.value("ERROR") < Levels.value("FATAL"), "error < fatal")
	end)

	suite:case("levelConstantsMatch", function(asserts)
		asserts.eq(Lustre.Level.DEBUG, "DEBUG")
		asserts.eq(Lustre.Level.FATAL, "FATAL")
	end)

	suite:case("parseCaseInsensitive", function(asserts)
		asserts.eq(Levels.parse("info"), "INFO")
		asserts.eq(Levels.parse("Info"), "INFO")
		asserts.eq(Levels.parse("INFO"), "INFO")
		asserts.eq(Levels.parse("warn"), "WARN")
		asserts.eq(Lustre.ParseLevel("error"), "ERROR")
	end)

	suite:case("parseInvalidThrows", function(asserts)
		asserts.throws(function()
			Levels.parse("verbose")
		end)
		asserts.throws(function()
			Levels.parse("")
		end)
	end)

	suite:case("valueInvalidThrows", function(asserts)
		asserts.throws(function()
			Levels.value("NOPE")
		end)
	end)

	suite:case("isValid", function(asserts)
		asserts.eq(Levels.isValid("INFO"), true)
		asserts.eq(Levels.isValid("info"), false)
		asserts.eq(Levels.isValid("BOGUS"), false)
	end)

	suite:case("customLevels", function(asserts)
		local name = Levels.register("NOTICE", 45)
		asserts.eq(name, "NOTICE")
		asserts.eq(Levels.isValid("NOTICE"), true)
		asserts.eq(Levels.parse("notice"), "NOTICE")
		asserts.that(Levels.value("SUCCESS") < Levels.value("NOTICE"), "success < notice")
		asserts.that(Levels.value("NOTICE") < Levels.value("WARN"), "notice < warn")
		asserts.throws(function()
			Levels.register("NOTICE", 46)
		end)
	end)

	suite:case("registerAboveBelow", function(asserts)
		local above = Levels.registerAbove("CRITICAL", "ERROR")
		asserts.eq(above, "CRITICAL")
		asserts.that(Levels.value("ERROR") < Levels.value("CRITICAL"), "error < critical")
		asserts.that(Levels.value("CRITICAL") < Levels.value("FATAL"), "critical < fatal")
		local below = Levels.registerBelow("VERBOSE", "TRACE")
		asserts.eq(below, "VERBOSE")
		asserts.that(Levels.value("VERBOSE") < Levels.value("TRACE"), "verbose < trace")
	end)

	suite:case("loggerAcceptsCustomLevel", function(asserts)
		Levels.register("AUDIT", 55)
		local lines = {}
		local logger = Lustre.new({
			level = "AUDIT",
			timestamp = false,
			color = false,
			output = function(line: string)
				table.insert(lines, line)
			end,
		})
		logger:Log("WARN", "too quiet")
		logger:Log("AUDIT", "just right")
		logger:Log("ERROR", "loud enough")
		asserts.eq(#lines, 2)
		asserts.strContains(lines[1], "AUDIT")
		asserts.strContains(lines[2], "ERROR")
	end)
end)
